# Todas as configurações de uso, inclusive a chave, podem ser preenchidas na página.
# Variáveis abaixo são opcionais, para definir padrões do servidor.
OPENROUTER_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE_SUPPORTED=false
MAX_TOKENS=800
CONCORRENCIA_LOTE=5
LIMIAR_SIMILARIDADE=0.4
# O padrão usa gerador/data/gerador.db. Um caminho relativo é resolvido a partir do cwd.
# DB_PATH=/caminho/gerador.db
